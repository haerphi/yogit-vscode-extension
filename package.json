{
    "name": "haerphi-yorgit",
    "displayName": "YorGit",
    "description": "An extension to help you using Git and have a clear visualisation of what you're doing!",
    "version": "1.3.0",
    "publisher": "haerphi",
    "license": "MIT",
    "packageManager": "pnpm@11.7.0",
    "repository": {
        "url": "https://github.com/haerphi/yorgit-vscode-extension"
    },
    "engines": {
        "vscode": "^1.125.0"
    },
    "categories": [
        "SCM Providers",
        "Other"
    ],
    "keywords": [
        "git",
        "scm",
        "branch",
        "rebase",
        "stash",
        "merge",
        "commit",
        "push",
        "pull",
        "version control"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onView:commit",
        "onView:branches",
        "onView:remotes",
        "onView:changes",
        "onView:stash"
    ],
    "main": "./out/extension.js",
    "extensionKind": [
        "workspace"
    ],
    "l10n": "./l10n",
    "contributes": {
        "commands": [
            {
                "command": "haerphi-yorgit.create-branch",
                "title": "%cmd.create-branch.title%",
                "icon": "$(add)"
            },
            {
                "command": "haerphi-yorgit.create-branch-from",
                "title": "%cmd.create-branch-from.title%"
            },
            {
                "command": "haerphi-yorgit.switch",
                "title": "%cmd.switch.title%",
                "icon": "$(arrow-right)"
            },
            {
                "command": "haerphi-yorgit.switch-force",
                "title": "%cmd.switch-force.title%"
            },
            {
                "command": "haerphi-yorgit.copy-branch-name",
                "title": "%cmd.copy-branch-name.title%"
            },
            {
                "command": "haerphi-yorgit.open-file",
                "title": "%cmd.open-file.title%"
            },
            {
                "command": "haerphi-yorgit.copy-file-name",
                "title": "%cmd.copy-file-name.title%"
            },
            {
                "command": "haerphi-yorgit.rename-branch",
                "title": "%cmd.rename-branch.title%"
            },
            {
                "command": "haerphi-yorgit.delete-branch",
                "title": "%cmd.delete-branch.title%",
                "icon": "$(trash)"
            },
            {
                "command": "haerphi-yorgit.delete-branch-remote",
                "title": "%cmd.delete-branch-remote.title%",
                "icon": "$(trash)"
            },
            {
                "command": "haerphi-yorgit.stage-file",
                "title": "%cmd.stage-file.title%",
                "icon": "$(add)"
            },
            {
                "command": "haerphi-yorgit.unstage-file",
                "title": "%cmd.unstage-file.title%",
                "icon": "$(remove)"
            },
            {
                "command": "haerphi-yorgit.stage-all",
                "title": "%cmd.stage-all.title%",
                "icon": "$(add)"
            },
            {
                "command": "haerphi-yorgit.unstage-all",
                "title": "%cmd.unstage-all.title%",
                "icon": "$(remove)"
            },
            {
                "command": "haerphi-yorgit.stage-hunks",
                "title": "%cmd.stage-hunks.title%",
                "icon": "$(list-selection)"
            },
            {
                "command": "haerphi-yorgit.unstage-hunks",
                "title": "%cmd.unstage-hunks.title%",
                "icon": "$(list-selection)"
            },
            {
                "command": "haerphi-yorgit.stash",
                "title": "%cmd.stash.title%",
                "icon": "$(archive)"
            },
            {
                "command": "haerphi-yorgit.show-log",
                "title": "%cmd.show-log.title%",
                "icon": "$(history)"
            },
            {
                "command": "haerphi-yorgit.fetch",
                "title": "%cmd.fetch.title%",
                "icon": "$(sync)"
            },
            {
                "command": "haerphi-yorgit.pull",
                "title": "%cmd.pull.title%",
                "icon": "$(arrow-down)"
            },
            {
                "command": "haerphi-yorgit.push",
                "title": "%cmd.push.title%",
                "icon": "$(arrow-up)"
            },
            {
                "command": "haerphi-yorgit.stash-show",
                "title": "%cmd.stash-show.title%"
            },
            {
                "command": "haerphi-yorgit.stash-pop",
                "title": "%cmd.stash-pop.title%",
                "icon": "$(run)"
            },
            {
                "command": "haerphi-yorgit.stash-apply",
                "title": "%cmd.stash-apply.title%"
            },
            {
                "command": "haerphi-yorgit.stash-drop",
                "title": "%cmd.stash-drop.title%",
                "icon": "$(trash)"
            },
            {
                "command": "haerphi-yorgit.merge",
                "title": "%cmd.merge.title%",
                "icon": "$(git-merge)"
            },
            {
                "command": "haerphi-yorgit.rebase-onto",
                "title": "%cmd.rebase-onto.title%",
                "icon": "$(git-commit)"
            },
            {
                "command": "haerphi-yorgit.rebase-interactive",
                "title": "%cmd.rebase-interactive.title%",
                "icon": "$(git-commit)"
            },
            {
                "command": "haerphi-yorgit.resolve-conflict",
                "title": "%cmd.resolve-conflict.title%",
                "icon": "$(diff)"
            },
            {
                "command": "haerphi-yorgit.resolve-conflict-ours",
                "title": "%cmd.resolve-conflict-ours.title%"
            },
            {
                "command": "haerphi-yorgit.resolve-conflict-theirs",
                "title": "%cmd.resolve-conflict-theirs.title%"
            },
            {
                "command": "haerphi-yorgit.abort-rebase",
                "title": "%cmd.abort-rebase.title%",
                "icon": "$(discard)"
            },
            {
                "command": "haerphi-yorgit.continue-rebase",
                "title": "%cmd.continue-rebase.title%",
                "icon": "$(play)"
            },
            {
                "command": "haerphi-yorgit.discard-file",
                "title": "%cmd.discard-file.title%",
                "icon": "$(discard)"
            },
            {
                "command": "haerphi-yorgit.discard-all",
                "title": "%cmd.discard-all.title%",
                "icon": "$(discard)"
            },
            {
                "command": "haerphi-yorgit.init-repo",
                "title": "%cmd.init-repo.title%",
                "icon": "$(repo-create)"
            },
            {
                "command": "haerphi-yorgit.clone-repo",
                "title": "%cmd.clone-repo.title%",
                "icon": "$(repo-clone)"
            },
            {
                "command": "haerphi-yorgit.link-repo",
                "title": "%cmd.link-repo.title%",
                "icon": "$(link)"
            },
            {
                "command": "haerphi-yorgit.add-remote",
                "title": "%cmd.add-remote.title%",
                "icon": "$(add)"
            },
            {
                "command": "haerphi-yorgit.filter-branches",
                "title": "%cmd.filter-branches.title%",
                "icon": "$(search)"
            },
            {
                "command": "haerphi-yorgit.clear-filter-branches",
                "title": "%cmd.clear-filter-branches.title%",
                "icon": "$(search-stop)"
            },
            {
                "command": "haerphi-yorgit.filter-remotes",
                "title": "%cmd.filter-remotes.title%",
                "icon": "$(search)"
            },
            {
                "command": "haerphi-yorgit.clear-filter-remotes",
                "title": "%cmd.clear-filter-remotes.title%",
                "icon": "$(search-stop)"
            },
            {
                "command": "haerphi-yorgit.toggle-inline-blame",
                "title": "%cmd.toggle-inline-blame.title%",
                "category": "YorGit"
            },
            {
                "command": "haerphi-yorgit.blame-show-commit",
                "title": "%cmd.blame-show-commit.title%",
                "category": "YorGit",
                "icon": "$(git-commit)"
            },
            {
                "command": "haerphi-yorgit.copy-blame-hash",
                "title": "%cmd.copy-blame-hash.title%",
                "category": "YorGit"
            }
        ],
        "keybindings": [
            {
                "command": "haerphi-yorgit.filter-branches",
                "key": "ctrl+f",
                "mac": "cmd+f",
                "when": "focusedView == branches"
            },
            {
                "command": "haerphi-yorgit.filter-remotes",
                "key": "ctrl+f",
                "mac": "cmd+f",
                "when": "focusedView == remotes"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "haerphi-yorgit.init-repo",
                    "when": "haerphi-yorgit.noRepo"
                },
                {
                    "command": "haerphi-yorgit.clone-repo",
                    "when": "haerphi-yorgit.noRepo"
                },
                {
                    "command": "haerphi-yorgit.link-repo",
                    "when": "haerphi-yorgit.noRepo"
                },
                {
                    "command": "haerphi-yorgit.clear-filter-branches",
                    "when": "haerphi-yorgit.branchesFiltered"
                },
                {
                    "command": "haerphi-yorgit.clear-filter-remotes",
                    "when": "haerphi-yorgit.remotesFiltered"
                },
                {
                    "command": "haerphi-yorgit.blame-show-commit",
                    "when": "haerphi-yorgit.hasBlame"
                },
                {
                    "command": "haerphi-yorgit.copy-blame-hash",
                    "when": "haerphi-yorgit.hasBlame"
                }
            ],
            "view/title": [
                {
                    "command": "haerphi-yorgit.show-log",
                    "when": "view == branches",
                    "group": "navigation@1"
                },
                {
                    "command": "haerphi-yorgit.fetch",
                    "when": "view == branches",
                    "group": "navigation@2"
                },
                {
                    "command": "haerphi-yorgit.pull",
                    "when": "view == branches",
                    "group": "navigation@3"
                },
                {
                    "command": "haerphi-yorgit.push",
                    "when": "view == branches",
                    "group": "navigation@4"
                },
                {
                    "command": "haerphi-yorgit.create-branch",
                    "when": "view == branches",
                    "group": "navigation@5"
                },
                {
                    "command": "haerphi-yorgit.filter-branches",
                    "when": "view == branches && !haerphi-yorgit.branchesFiltered",
                    "group": "navigation@6"
                },
                {
                    "command": "haerphi-yorgit.clear-filter-branches",
                    "when": "view == branches && haerphi-yorgit.branchesFiltered",
                    "group": "navigation@6"
                },
                {
                    "command": "haerphi-yorgit.fetch",
                    "when": "view == remotes",
                    "group": "navigation@1"
                },
                {
                    "command": "haerphi-yorgit.add-remote",
                    "when": "view == remotes",
                    "group": "navigation@2"
                },
                {
                    "command": "haerphi-yorgit.filter-remotes",
                    "when": "view == remotes && !haerphi-yorgit.remotesFiltered",
                    "group": "navigation@3"
                },
                {
                    "command": "haerphi-yorgit.clear-filter-remotes",
                    "when": "view == remotes && haerphi-yorgit.remotesFiltered",
                    "group": "navigation@3"
                },
                {
                    "command": "haerphi-yorgit.stash",
                    "when": "view == changes",
                    "group": "navigation"
                },
                {
                    "command": "haerphi-yorgit.abort-rebase",
                    "when": "view == changes && haerphi-yorgit.rebaseInProgress",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "haerphi-yorgit.switch",
                    "when": "(view == branches || view == remotes) && viewItem =~ /^branch/",
                    "group": "inline"
                },
                {
                    "command": "haerphi-yorgit.switch",
                    "when": "(view == branches || view == remotes) && viewItem =~ /^branch/",
                    "group": "1_switch@1"
                },
                {
                    "command": "haerphi-yorgit.switch-force",
                    "when": "(view == branches || view == remotes) && viewItem =~ /^branch/",
                    "group": "1_switch@2"
                },
                {
                    "command": "haerphi-yorgit.create-branch-from",
                    "when": "(view == branches || view == remotes) && viewItem =~ /^branch/",
                    "group": "2_branch@1"
                },
                {
                    "command": "haerphi-yorgit.rename-branch",
                    "when": "view == branches && viewItem =~ /^branch-local/",
                    "group": "2_branch@2"
                },
                {
                    "command": "haerphi-yorgit.merge",
                    "when": "(view == branches || view == remotes) && viewItem =~ /^branch/ && viewItem != branch-local-current",
                    "group": "3_rebase@1"
                },
                {
                    "command": "haerphi-yorgit.rebase-onto",
                    "when": "(view == branches || view == remotes) && viewItem =~ /^branch/ && viewItem != branch-local-current",
                    "group": "3_rebase@2"
                },
                {
                    "command": "haerphi-yorgit.rebase-interactive",
                    "when": "(view == branches || view == remotes) && viewItem =~ /^branch/ && viewItem != branch-local-current",
                    "group": "3_rebase@3"
                },
                {
                    "command": "haerphi-yorgit.pull",
                    "when": "view == branches && viewItem == branch-local-current",
                    "group": "inline"
                },
                {
                    "command": "haerphi-yorgit.push",
                    "when": "view == branches && viewItem == branch-local-current",
                    "group": "inline"
                },
                {
                    "command": "haerphi-yorgit.pull",
                    "when": "view == branches && viewItem == branch-local-current",
                    "group": "1_sync@1"
                },
                {
                    "command": "haerphi-yorgit.push",
                    "when": "view == branches && viewItem == branch-local-current",
                    "group": "1_sync@2"
                },
                {
                    "command": "haerphi-yorgit.delete-branch",
                    "when": "view == branches && viewItem =~ /^branch-local/",
                    "group": "4_delete"
                },
                {
                    "command": "haerphi-yorgit.delete-branch-remote",
                    "when": "view == remotes && viewItem == branch-remote",
                    "group": "4_delete"
                },
                {
                    "command": "haerphi-yorgit.copy-branch-name",
                    "when": "(view == branches || view == remotes) && viewItem =~ /^branch/",
                    "group": "5_copy"
                },
                {
                    "command": "haerphi-yorgit.stage-file",
                    "when": "view == changes && viewItem == change-unstaged",
                    "group": "inline"
                },
                {
                    "command": "haerphi-yorgit.stage-hunks",
                    "when": "view == changes && viewItem == change-unstaged",
                    "group": "inline"
                },
                {
                    "command": "haerphi-yorgit.stage-file",
                    "when": "view == changes && viewItem == change-unstaged",
                    "group": "1_stage@1"
                },
                {
                    "command": "haerphi-yorgit.stage-hunks",
                    "when": "view == changes && viewItem == change-unstaged",
                    "group": "1_stage@2"
                },
                {
                    "command": "haerphi-yorgit.unstage-file",
                    "when": "view == changes && viewItem == change-staged",
                    "group": "inline"
                },
                {
                    "command": "haerphi-yorgit.unstage-hunks",
                    "when": "view == changes && viewItem == change-staged",
                    "group": "inline"
                },
                {
                    "command": "haerphi-yorgit.unstage-file",
                    "when": "view == changes && viewItem == change-staged",
                    "group": "1_stage@1"
                },
                {
                    "command": "haerphi-yorgit.unstage-hunks",
                    "when": "view == changes && viewItem == change-staged",
                    "group": "1_stage@2"
                },
                {
                    "command": "haerphi-yorgit.resolve-conflict",
                    "when": "view == changes && viewItem == change-conflict",
                    "group": "inline"
                },
                {
                    "command": "haerphi-yorgit.resolve-conflict",
                    "when": "view == changes && viewItem == change-conflict",
                    "group": "1_resolve@1"
                },
                {
                    "command": "haerphi-yorgit.resolve-conflict-ours",
                    "when": "view == changes && viewItem == change-conflict",
                    "group": "1_resolve@2"
                },
                {
                    "command": "haerphi-yorgit.resolve-conflict-theirs",
                    "when": "view == changes && viewItem == change-conflict",
                    "group": "1_resolve@3"
                },
                {
                    "command": "haerphi-yorgit.stage-all",
                    "when": "view == changes && viewItem == group-unstaged",
                    "group": "inline"
                },
                {
                    "command": "haerphi-yorgit.discard-all",
                    "when": "view == changes && viewItem == group-unstaged",
                    "group": "inline"
                },
                {
                    "command": "haerphi-yorgit.discard-all",
                    "when": "view == changes && viewItem == group-unstaged",
                    "group": "1_discard"
                },
                {
                    "command": "haerphi-yorgit.unstage-all",
                    "when": "view == changes && viewItem == group-staged",
                    "group": "inline"
                },
                {
                    "command": "haerphi-yorgit.discard-file",
                    "when": "view == changes && viewItem == change-unstaged",
                    "group": "2_discard"
                },
                {
                    "command": "haerphi-yorgit.open-file",
                    "when": "view == changes && viewItem =~ /^change/",
                    "group": "3_file@1"
                },
                {
                    "command": "haerphi-yorgit.copy-file-name",
                    "when": "view == changes && viewItem =~ /^change/",
                    "group": "3_file@2"
                },
                {
                    "command": "haerphi-yorgit.stash-pop",
                    "when": "view == stash && viewItem == stash-entry",
                    "group": "inline"
                },
                {
                    "command": "haerphi-yorgit.stash-drop",
                    "when": "view == stash && viewItem == stash-entry",
                    "group": "inline"
                },
                {
                    "command": "haerphi-yorgit.stash-pop",
                    "when": "view == stash && viewItem == stash-entry",
                    "group": "1_apply@1"
                },
                {
                    "command": "haerphi-yorgit.stash-apply",
                    "when": "view == stash && viewItem == stash-entry",
                    "group": "1_apply@2"
                },
                {
                    "command": "haerphi-yorgit.stash-drop",
                    "when": "view == stash && viewItem == stash-entry",
                    "group": "2_delete"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "yorgit-side-panel",
                    "title": "YorGit",
                    "icon": "media/yorgit.png"
                }
            ]
        },
        "views": {
            "yorgit-side-panel": [
                {
                    "id": "commit",
                    "name": "%view.commit.name%",
                    "type": "webview"
                },
                {
                    "id": "changes",
                    "name": "%view.changes.name%"
                },
                {
                    "id": "stash",
                    "name": "%view.stash.name%"
                },
                {
                    "id": "branches",
                    "name": "%view.branches.name%"
                },
                {
                    "id": "remotes",
                    "name": "%view.remotes.name%"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "branches",
                "contents": "%welcome.branches.noRepo%",
                "when": "haerphi-yorgit.noRepo"
            },
            {
                "view": "branches",
                "contents": "%welcome.branches.filtered%",
                "when": "!haerphi-yorgit.noRepo && haerphi-yorgit.branchesFiltered"
            },
            {
                "view": "remotes",
                "contents": "%welcome.remotes.default%",
                "when": "!haerphi-yorgit.noRepo && !haerphi-yorgit.remotesFiltered"
            },
            {
                "view": "remotes",
                "contents": "%welcome.remotes.filtered%",
                "when": "!haerphi-yorgit.noRepo && haerphi-yorgit.remotesFiltered"
            },
            {
                "view": "remotes",
                "contents": "%welcome.remotes.noRepo%",
                "when": "haerphi-yorgit.noRepo"
            },
            {
                "view": "changes",
                "contents": "%welcome.changes.default%",
                "when": "!haerphi-yorgit.noRepo"
            },
            {
                "view": "changes",
                "contents": "%welcome.changes.noRepo%",
                "when": "haerphi-yorgit.noRepo"
            },
            {
                "view": "stash",
                "contents": "%welcome.stash.default%",
                "when": "!haerphi-yorgit.noRepo"
            },
            {
                "view": "stash",
                "contents": "%welcome.stash.noRepo%",
                "when": "haerphi-yorgit.noRepo"
            }
        ],
        "configuration": {
            "title": "YorGit",
            "properties": {
                "haerphi-yorgit.language": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "en",
                        "fr"
                    ],
                    "enumDescriptions": [
                        "%config.language.enum.auto%",
                        "%config.language.enum.en%",
                        "%config.language.enum.fr%"
                    ],
                    "default": "auto",
                    "description": "%config.language.description%"
                },
                "haerphi-yorgit.blame.inline": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.blame.inline.description%"
                },
                "haerphi-yorgit.blame.statusBar": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.blame.statusBar.description%"
                },
                "haerphi-yorgit.blame.delay": {
                    "type": "number",
                    "default": 200,
                    "minimum": 0,
                    "maximum": 5000,
                    "description": "%config.blame.delay.description%"
                },
                "haerphi-yorgit.rebase.defaultOrder": {
                    "type": "string",
                    "enum": [
                        "oldest-first",
                        "newest-first"
                    ],
                    "enumDescriptions": [
                        "%config.rebase.defaultOrder.enum.oldestFirst%",
                        "%config.rebase.defaultOrder.enum.newestFirst%"
                    ],
                    "default": "oldest-first",
                    "description": "%config.rebase.defaultOrder.description%"
                }
            }
        }
    },
    "extensionDependencies": [
        "vscode.git"
    ],
    "scripts": {
        "vscode:prepublish": "pnpm run compile",
        "compile": "tsc -p ./ && esbuild src/webview/modal/index.ts --bundle --outfile=out/webview/modal.js --format=iife --platform=browser --tsconfig=tsconfig.webview.json && esbuild src/webview/diff/index.ts --bundle --outfile=out/webview/diff.js --format=iife --platform=browser --tsconfig=tsconfig.webview.json && esbuild src/webview/commit/index.ts --bundle --outfile=out/webview/commit.js --format=iife --platform=browser --tsconfig=tsconfig.webview.json && esbuild src/webview/commit-detail/index.ts --bundle --outfile=out/webview/commit-detail.js --format=iife --platform=browser --tsconfig=tsconfig.webview.json && esbuild src/webview/log/index.ts --bundle --outfile=out/webview/log.js --format=iife --platform=browser --tsconfig=tsconfig.webview.json && esbuild src/webview/rebase/index.ts --bundle --outfile=out/webview/rebase.js --format=iife --platform=browser --tsconfig=tsconfig.webview.json && esbuild src/webview/conflict/index.ts --bundle --outfile=out/webview/conflict.js --format=iife --platform=browser --tsconfig=tsconfig.webview.json",
        "watch:ext": "tsc -watch -p ./",
